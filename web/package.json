{
  "name": "domain-driven-trading-web",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo workspace for Domain-Driven Trading Web Applications",
  "scripts": {
    "dev": "pnpm --filter @trading/client dev",
    "dev:client": "pnpm --filter @trading/client dev",
    "dev:admin": "pnpm --filter @trading/admin dev",
    "dev:all": "concurrently \"pnpm run dev:client\" \"pnpm run dev:admin\"",
    "build": "pnpm -r run build",
    "build:client": "pnpm --filter @trading/client build",
    "build:admin": "pnpm --filter @trading/admin build",
    "preview:client": "pnpm --filter @trading/client preview",
    "preview:admin": "pnpm --filter @trading/admin preview",
    "type-check": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
